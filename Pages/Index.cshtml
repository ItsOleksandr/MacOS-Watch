@page
@{
    Layout = null;
    ViewData["Title"] = "MacControl";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover" />
<title>MacControl</title>
@* Home-screen shortcut metadata. Chrome only builds a standalone WebAPK over
   HTTPS, so on a plain-HTTP LAN the shortcut opens in the browser — but it still
   picks up the icon and name from here instead of a screenshot and a URL. *@
<link rel="manifest" href="~/manifest.webmanifest" />
<link rel="icon" href="~/icons/icon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
<meta name="theme-color" content="#111111" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="MacControl" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<style>
:root { color-scheme: dark; }
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body { margin: 0; font-family: -apple-system, system-ui, sans-serif; background: #111; color: #eee; padding: 16px; max-width: 520px; margin: 0 auto; }
h2 { font-size: 14px; text-transform: uppercase; opacity: .6; margin: 18px 0 8px; letter-spacing: .1em; }
button { background: #2a2a2a; color: #eee; border: 1px solid #3a3a3a; border-radius: 10px; padding: 14px; font-size: 16px; flex: 1; cursor: pointer; touch-action: manipulation; }
button:active { background: #3a3a3a; }
.row { display: flex; gap: 8px; margin-bottom: 8px; }
input[type=range] { width: 100%; height: 36px; }
.vol { display: flex; align-items: center; gap: 12px; }
.vol-val { width: 44px; text-align: right; font-variant-numeric: tabular-nums; }
.pad { background: #1c1c1c; border: 1px solid #333; border-radius: 12px; height: 240px; touch-action: none; user-select: none; display: flex; align-items: center; justify-content: center; color: #555; }
.big { font-size: 18px; padding: 18px; }
details { margin-top: 22px; border: 1px solid #333; border-radius: 12px; background: #1c1c1c; }
summary { padding: 14px; cursor: pointer; font-size: 14px; text-transform: uppercase; letter-spacing: .1em; opacity: .7; }
.pair-body { padding: 0 14px 16px; text-align: center; }
/* The library draws onto a white canvas; the padding keeps a quiet zone around
   the code so scanners are not thrown off by the dark page behind it. */
#qrcode { display: inline-block; background: #fff; padding: 12px; border-radius: 10px; line-height: 0; }
#qrcode img, #qrcode canvas { display: block; }
.pair-url { margin-top: 12px; font-size: 12px; word-break: break-all; opacity: .75; font-family: ui-monospace, monospace; }
.pair-hint { margin-top: 8px; font-size: 12px; opacity: .5; }
</style>
</head>
<body>
<h1 style="font-size:20px;margin:8px 0">MacControl</h1>

<h2>Playback</h2>
<div class="row">
  <button class="big" onclick="post('/api/playpause')">▶︎ / ❚❚</button>
</div>
<div class="row">
  <button onclick="post('/api/key/arrow-left')">⏮ ←</button>
  <button onclick="post('/api/key/arrow-right')">→ ⏭</button>
  <button onclick="post('/api/key/esc')">Esc</button>
  <button onclick="post('/api/key/return')">Enter</button>
</div>
<div class="row">
  <button onclick="post('/api/key/f')">Fullscreen (F)</button>
  <button onclick="post('/api/key/m')">Mute (M)</button>
</div>

<h2>Volume <span id="volLabel" class="vol-val" style="float:right"></span></h2>
<div class="vol">
  <input type="range" id="vol" min="0" max="100" value="50" />
</div>
<div class="row">
  <button onclick="setVol(getVol()-5)">−5</button>
  <button onclick="setVol(getVol()+5)">+5</button>
  <button id="muteBtn" onclick="toggleMute()">Mute</button>
</div>

<h2>Trackpad</h2>
<div class="pad" id="pad">drag to move · tap to click · two-finger scroll</div>
<div class="row">
  <button onclick="post('/api/mouse/click/left')">Left Click</button>
  <button onclick="post('/api/mouse/click/right')">Right Click</button>
  <button onclick="post('/api/mouse/click/double')">Double</button>
</div>

<details id="pair">
  <summary>Open on phone</summary>
  <div class="pair-body">
    <div id="qrcode"></div>
    <div class="pair-url" id="pairUrl"></div>
    <div class="pair-hint" id="pairHint">Scan this with the phone camera, on the same network.</div>
  </div>
</details>

<script src="~/js/qrcode.js"></script>
<script>
// --- Shared control token: read from ?token= on first open, then remembered.
const params = new URLSearchParams(location.search);
if (params.has('token')) {
  localStorage.setItem('mc_token', params.get('token'));
  // Strip it from the address bar so it does not linger in history or screenshots.
  history.replaceState(null, '', location.pathname);
}
const TOKEN = localStorage.getItem('mc_token') || '';
function authHeaders(extra) { return Object.assign({ 'X-MacControl-Token': TOKEN }, extra || {}); }

const vol = document.getElementById('vol');
const volLabel = document.getElementById('volLabel');
const muteBtn = document.getElementById('muteBtn');
let muted = false;

function post(u, body) {
  return fetch(u, { method:'POST', headers: authHeaders(body?{'Content-Type':'application/json'}:{}), body: body?JSON.stringify(body):null });
}
function getVol(){ return parseInt(vol.value,10); }
function setVol(v){ v=Math.max(0,Math.min(100,v)); vol.value=v; volLabel.textContent=v; post('/api/volume/'+v); }
function toggleMute(){ muted=!muted; post('/api/mute/'+muted); muteBtn.textContent = muted?'Unmute':'Mute'; }

let volTimer=null;
vol.addEventListener('input', () => {
  volLabel.textContent = vol.value;
  clearTimeout(volTimer);
  volTimer = setTimeout(()=>post('/api/volume/'+vol.value), 60);
});

fetch('/api/volume', { headers: authHeaders() }).then(r => {
  if (r.status === 401) {
    document.body.insertAdjacentHTML('afterbegin',
      '<div style="background:#5a1a1a;color:#ffd5d5;padding:12px;border-radius:8px;margin-bottom:12px">' +
      '🔒 Missing or invalid token. Open this page using the link that ends in ' +
      '<code>?token=…</code> (shown by the install script).</div>');
    throw new Error('unauthorized');
  }
  return r.json();
}).then(d => {
  vol.value = d.volume; volLabel.textContent = d.volume;
  muted = d.muted; muteBtn.textContent = muted?'Unmute':'Mute';
  checkAccessibility();
}).catch(() => {});

// Build the pairing QR once the section is first opened — the address is asked
// of the server rather than taken from location.host, because opening this page
// on the Mac itself gives "localhost", which the phone cannot reach.
var pairDone = false;
document.getElementById('pair').addEventListener('toggle', function () {
  if (!this.open || pairDone) return;
  pairDone = true;
  fetch('/api/lan-address', { headers: authHeaders() })
    .then(r => r.json())
    .then(d => {
      var hint = document.getElementById('pairHint');
      if (!d.address) { hint.textContent = 'No LAN address found — is this Mac on Wi-Fi?'; return; }
      var url = 'http://' + d.address + ':' + (location.port || 80) + '/'
              + (TOKEN ? '?token=' + encodeURIComponent(TOKEN) : '');
      document.getElementById('pairUrl').textContent = url;
      new QRCode(document.getElementById('qrcode'), {
        text: url, width: 220, height: 220,
        colorDark: '#000000', colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M
      });
    })
    .catch(() => { document.getElementById('pairHint').textContent = 'Could not read the LAN address.'; });
});

// Without the Accessibility grant the trackpad and keys post events that macOS
// throws away: every request still returns 200, so the UI has to say so out loud.
function checkAccessibility() {
  fetch('/api/accessibility', { headers: authHeaders() })
    .then(r => r.json())
    .then(a => {
      if (a.trusted) return;
      document.body.insertAdjacentHTML('afterbegin',
        '<div style="background:#5a4a1a;color:#ffe9b0;padding:12px;border-radius:8px;margin-bottom:12px;font-size:14px">' +
        '⚠️ <b>Accessibility is off</b> — volume works, but the trackpad and keys do nothing.<br>' +
        'On the Mac: System Settings → Privacy &amp; Security → Accessibility → enable <b>MacControl</b>.</div>');
    })
    .catch(() => {});
}

// Trackpad
const pad = document.getElementById('pad');
let last = null, moved = false, startT = 0, lastTap = 0, twoFinger = false, lastScrollY = 0;
const SENS = 1.6;
// Coalesce touchmove deltas: at 60Hz a finger drag fires ~60 events/sec, each
// spawning a cliclick. Accumulate deltas and flush at most every ~33ms (~30Hz).
let pendDx = 0, pendDy = 0, moveTimer = null;
function flushMove(){
  moveTimer = null;
  if (pendDx || pendDy){
    const dx = pendDx, dy = pendDy;
    pendDx = 0; pendDy = 0;
    post('/api/mouse/move', { dx, dy });
  }
}
function queueMove(dx, dy){
  pendDx += dx; pendDy += dy;
  if (!moveTimer) moveTimer = setTimeout(flushMove, 33);
}

pad.addEventListener('touchstart', e => {
  e.preventDefault();
  if (e.touches.length === 2) {
    twoFinger = true;
    lastScrollY = (e.touches[0].clientY + e.touches[1].clientY)/2;
    return;
  }
  twoFinger = false;
  last = { x: e.touches[0].clientX, y: e.touches[0].clientY };
  moved = false; startT = Date.now();
}, {passive:false});

pad.addEventListener('touchmove', e => {
  e.preventDefault();
  if (twoFinger && e.touches.length === 2) {
    const y = (e.touches[0].clientY + e.touches[1].clientY)/2;
    const dy = y - lastScrollY;
    if (Math.abs(dy) > 6) {
      post('/api/mouse/scroll/' + Math.round(-dy/8));
      lastScrollY = y;
    }
    return;
  }
  if (!last) return;
  const t = e.touches[0];
  const dx = Math.round((t.clientX - last.x) * SENS);
  const dy = Math.round((t.clientY - last.y) * SENS);
  if (dx || dy) {
    moved = true;
    queueMove(dx, dy);
    last = { x: t.clientX, y: t.clientY };
  }
}, {passive:false});

pad.addEventListener('touchend', e => {
  e.preventDefault();
  if (twoFinger) { twoFinger=false; return; }
  const dt = Date.now() - startT;
  if (!moved && dt < 250) {
    const now = Date.now();
    if (now - lastTap < 300) post('/api/mouse/click/double');
    else post('/api/mouse/click/left');
    lastTap = now;
  }
  last = null;
}, {passive:false});

// Mouse fallback for desktop
let dragging=false, mlast=null;
pad.addEventListener('mousedown', e => { dragging=true; mlast={x:e.clientX,y:e.clientY}; moved=false; });
pad.addEventListener('mousemove', e => {
  if (!dragging) return;
  const dx = Math.round((e.clientX-mlast.x)*SENS), dy = Math.round((e.clientY-mlast.y)*SENS);
  if (dx||dy){ moved=true; queueMove(dx, dy); mlast={x:e.clientX,y:e.clientY}; }
});
pad.addEventListener('mouseup', () => { if (dragging && !moved) post('/api/mouse/click/left'); dragging=false; });
</script>
</body>
</html>
